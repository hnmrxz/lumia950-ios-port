# Kernel configuration of the lumia950 image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the
# kernel build.
#
# This is the storage-bring-up configuration: the platform expert, the CPU and interrupt
# path, and the eMMC driver. Everything that needs a working display, userland or power
# management is deliberately absent.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_SDHCI=y
# Rung 1 of the GPU: identity. The archive is built and the personality is
# documented in README.md, "Linking it into the kernel"; no GPU service is
# published, so nothing that looks for a Metal device can bind it yet.
CONFIG_XNU_NATIVE_ADRENO418=y
# Rung 1 of the display. The archive is built and the personality is documented in
# README.md, "Linking it into the kernel"; no framebuffer is published, so nothing
# draws into a surface nothing scans out.
CONFIG_XNU_NATIVE_MDSS=y

# ArmCpu is only accepted with the real source crypto provider, and the kernel
# link expects the namespaced corecrypto archive that the builders above make.
CONFIG_XNU_SOURCE_CORECRYPTO14=y

# bsd_init calls pthread_init() before anything else in BSD and panics with
# "pthread kernel extension not loaded (function table is NULL)" unless the source pthread
# component has registered its function table, and the merged kernelcache components do not
# carry the pthread kext. The source component is therefore required, but enabling
# CONFIG_XNU_SOURCE_PTHREAD=y does not build on this pin: its builder compiles libpthread
# against the xnu-8796 compile records and fails, and the builder's own make run loses the
# extra force-loaded archives, leaving the XNU link with undefined
# _corecrypto_kext_start and _native_legacy_display_probe (runs 45129657068, 45130662811).
# Measured again on 2026-11-23 (run 45148280730): with the flag and its builder on, libpthread
# compiles and the failure moves to the XNU link, which then cannot find
# _corecrypto_kext_start or _native_legacy_display_probe. So the blocker is not a missing
# builder but the link archive set the framework uses on this line; measured panic:
# docs/emulation/2026-11-17-local-qemu-bsd-init-panic.json

# Run the archive builders of [kernel] archives. NativeSdhci is compiled by
# scripts/build-arm-driver.py against the compile records of the XNU pass.
CONFIG_XNU_BUILD_ARCHIVES=y

# Upstream calls native_legacy_display_probe() from bsd_init.c without the
# XNU_NATIVE_LEGACY_DISPLAY guard that every other call site has, so the kernel needs
# the symbol even with the display provider unselected. The kernel script's
# XNU_EXTRA_LD_ARCHIVES hook is for exactly this: a stub for an unselected offline probe.
#
# The display and GPU drivers are force-loaded for the same reason plus one: CONFIG_XNU_NATIVE_*
# builds their archives but nothing referenced their code, so the linker dropped every member and
# the image carried no display or GPU driver. The kernel job was green because no step read the
# symbol table; scripts/check-kernel-link.py does now.
#
# NativeSdhci is NOT here, and that is a finding rather than an omission: it subclasses
# IOBlockStorageDevice, which lives in IOStorageFamily and only exists after the prelink merge, so
# the source link cannot resolve it. See [kernel.link_excluded] in board.toml.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/native-legacy-display/libNativeLegacyDisplay.a -Wl,-force_load,{tree}/build/native-mdss/libNativeMdss.a -Wl,-force_load,{tree}/build/native-adreno418/libNativeAdreno418.a"

# The Data volume is a RAM block until the eMMC write path exists.
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set

CONFIG_XNU_ARMVIRT_PLATFORM=n

# The source-only early-boot image has no prelinked provider to initialize crypto.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"


CONFIG_XNU_SOURCE_PTHREAD=y
